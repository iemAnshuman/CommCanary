{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.application_oracle.v1.schema.json",
  "title": "CommCanary replicated application oracle v1",
  "type": "object",
  "required": ["format", "oracle_id", "runner", "subject_sha256", "subject_configuration", "perturbation_id", "application", "workload", "allocations", "summary", "environment_sha256", "allocation_policy", "allocation_assessment"],
  "properties": {
    "format": {"const": "commcanary.application_oracle.v1"},
    "oracle_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "runner": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json#/properties/runner"},
    "subject_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "subject_configuration": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json#/$defs/subjectConfiguration"},
    "perturbation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
    "application": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json#/properties/application"},
    "workload": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json#/properties/workload"},
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repetition", "planned_position", "chunk_id", "allocation_id", "node", "start_time", "end_time", "elapsed_seconds", "measurement"],
        "properties": {
          "repetition": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
          "planned_position": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
          "chunk_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "allocation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "node": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "start_time": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "end_time": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "elapsed_seconds": {"type": "integer", "minimum": 1},
          "measurement": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json"}
        },
        "additionalProperties": false
      }
    },
    "summary": {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json#/properties/summary"},
    "environment_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "allocation_policy": {
      "type": "object",
      "required": ["minimum_allocations", "minimum_distinct_days", "maximum_allocation_elapsed_seconds"],
      "properties": {
        "minimum_allocations": {"type": "integer", "minimum": 1},
        "minimum_distinct_days": {"type": "integer", "minimum": 1},
        "maximum_allocation_elapsed_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "allocation_assessment": {
      "type": "object",
      "required": ["comparable", "issues", "allocation_count", "distinct_node_count", "distinct_day_count", "maximum_allocation_elapsed_seconds"],
      "properties": {
        "comparable": {"type": "boolean"},
        "issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"}},
        "allocation_count": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "distinct_node_count": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "distinct_day_count": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "maximum_allocation_elapsed_seconds": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
