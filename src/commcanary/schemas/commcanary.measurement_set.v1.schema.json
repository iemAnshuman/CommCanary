{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.measurement_set.v1.schema.json",
  "title": "CommCanary measurement set v1",
  "type": "object",
  "required": ["format", "name", "role", "metric", "direction", "measurements"],
  "properties": {
    "format": {"const": "commcanary.measurement_set.v1"},
    "name": {"type": "string", "minLength": 1},
    "role": {"enum": ["reference", "proxy"]},
    "metric": {"type": "string", "minLength": 1},
    "direction": {"enum": ["lower_is_better", "higher_is_better"]},
    "measurements": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 32,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "reference"}}, "required": ["role"]},
      "then": {
        "properties": {
          "measurements": {
            "additionalProperties": {
              "items": {"exclusiveMinimum": 0}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
