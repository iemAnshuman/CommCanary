{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.trace.v1.schema.json",
  "title": "CommCanary trace v1",
  "description": "Portable shape for commcanary.trace.v1. Rank membership, arrival-key coverage, point-to-point endpoints, and derived timing relationships require runtime validation.",
  "type": "object",
  "required": [
    "format",
    "events"
  ],
  "properties": {
    "format": {
      "const": "commcanary.trace.v1"
    },
    "workload": {
      "type": "object"
    },
    "system": {
      "type": "object",
      "properties": {
        "kineto_source_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/sourceProfileIdentity"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sourceProfileIdentity": {
      "type": "object",
      "required": [
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "rank": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false
    },
    "computeRecipeOperation": {
      "type": "object",
      "required": [
        "op",
        "dtype",
        "m",
        "n",
        "k",
        "source_kernel_count",
        "source_kernel_duration_us"
      ],
      "properties": {
        "op": {
          "const": "gemm"
        },
        "dtype": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/dtype"
        },
        "m": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "n": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "k": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "source_kernel_count": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "source_kernel_duration_us": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000
        }
      },
      "additionalProperties": false
    },
    "computeRecipe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/computeRecipeOperation"
      }
    },
    "event": {
      "type": "object",
      "required": [
        "op",
        "bytes",
        "ranks"
      ],
      "properties": {
        "op": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"
        },
        "custom_op": {
          "type": "boolean"
        },
        "dtype": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/dtype"
        },
        "bytes": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "ranks": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/ranks"
        },
        "rank_count": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "phase": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"
        },
        "group": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"
        },
        "rank_arrival_us": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeNumber"
              }
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[0-9]+$"
              },
              "additionalProperties": {
                "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeNumber"
              }
            }
          ]
        },
        "partial_rank_arrival": {
          "type": "boolean"
        },
        "arrival_skew_us": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeNumber"
        },
        "start_us": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "gap_us": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "compute_before_us": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "compute_overlap_us": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "compute_overlap_unknown": {
          "type": "boolean"
        },
        "compute_recipe": {
          "$ref": "#/$defs/computeRecipe"
        },
        "compute_recipe_by_rank": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/computeRecipe"
          }
        },
        "compute_pressure": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeNumber"
        },
        "observed_exposed_us": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "concurrent_groups": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/positiveInteger"
        },
        "sender_rank": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"
        },
        "receiver_rank": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"
        },
        "root_rank": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"
        },
        "reduction_op": {
          "enum": [
            "avg",
            "max",
            "min",
            "product",
            "sum"
          ]
        },
        "message_sequence": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"
        },
        "tag": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"
        },
        "channel": {
          "$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    }
  }
}
