{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.qualification_observation.v1.schema.json",
  "title": "CommCanary raw qualification observation v1",
  "type": "object",
  "required": ["format", "observation_id", "request_id", "materialization_id", "policy_id", "role", "metric", "environment", "execution", "measurement", "claims"],
  "properties": {
    "format": {"const": "commcanary.qualification_observation.v1"},
    "observation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "request_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "materialization_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "policy_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "role": {"enum": ["baseline", "candidate"]},
    "metric": {
      "type": "object",
      "required": ["name", "unit", "lower_is_better"],
      "properties": {
        "name": {"const": "program_median_us"},
        "unit": {"const": "microseconds"},
        "lower_is_better": {"const": true}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["gpu_count", "topology_class", "software_stack_sha256", "clock_variation_pct"],
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "topology_class": {"type": "string", "minLength": 1},
        "software_stack_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
        "clock_variation_pct": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["executor", "executor_version", "hostname", "job_id", "observed_at"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "executor_version": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "job_id": {"type": ["string", "null"], "minLength": 1},
        "observed_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["warmup_count", "samples_us", "discarded_attempts", "correctness"],
      "properties": {
        "warmup_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "samples_us": {"type": "array", "minItems": 1, "maxItems": 2000000, "items": {"type": "number", "exclusiveMinimum": 0}},
        "discarded_attempts": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "correctness": {
          "type": "object",
          "required": ["status", "check_count"],
          "properties": {
            "status": {"enum": ["pass", "fail"]},
            "check_count": {"type": "integer", "minimum": 1, "maximum": 1000000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["physical_execution", "executor_conformance", "physical_decision", "producer_authenticity"],
      "properties": {
        "physical_execution": {"const": "observed"},
        "executor_conformance": {"const": "unproven"},
        "physical_decision": {"const": "not_interpreted"},
        "producer_authenticity": {"const": "unsigned"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
