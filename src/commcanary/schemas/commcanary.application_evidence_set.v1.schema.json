{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.application_evidence_set.v1.schema.json",
  "title": "CommCanary application evidence set v1",
  "type": "object",
  "required": ["format", "evidence_set_id", "runner_oci_digest", "splits"],
  "properties": {
    "format": {"const": "commcanary.application_evidence_set.v1"},
    "evidence_set_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "runner_oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "splits": {
      "type": "object",
      "required": ["training", "holdout"],
      "properties": {
        "training": {"$ref": "#/$defs/evidenceSplit"},
        "holdout": {"$ref": "#/$defs/evidenceSplit"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "applicationEvidence": {
      "oneOf": [
        {"$ref": "https://commcanary.dev/schemas/commcanary.application_measurement.v1.schema.json"},
        {"$ref": "https://commcanary.dev/schemas/commcanary.application_oracle.v1.schema.json"}
      ]
    },
    "evidenceSplit": {
      "type": "object",
      "required": ["baseline", "perturbations"],
      "properties": {
        "baseline": {"$ref": "#/$defs/applicationEvidence"},
        "perturbations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["perturbation_id", "evidence"],
            "properties": {
              "perturbation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
              "evidence": {"$ref": "#/$defs/applicationEvidence"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

