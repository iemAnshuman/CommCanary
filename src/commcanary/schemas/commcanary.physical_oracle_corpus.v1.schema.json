{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.physical_oracle_corpus.v1.schema.json",
  "title": "CommCanary physical oracle corpus v1",
  "type": "object",
  "required": ["format", "corpus_id", "source_et_sha256", "projection_id", "policy_id", "runner_oci_digest", "baseline_subject_sha256", "evidence_kind", "application", "perturbations", "evaluations"],
  "properties": {
    "format": {"const": "commcanary.physical_oracle_corpus.v1"},
    "corpus_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "source_et_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "projection_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "policy_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "runner_oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "baseline_subject_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "evidence_kind": {"enum": ["measured", "synthetic"]},
    "application": {
      "type": "object",
      "required": ["ground_truth_kind", "name", "engine", "artifact_sha256"],
      "properties": {
        "ground_truth_kind": {"const": "application_ground_truth"},
        "name": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "engine": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "artifact_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "perturbations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["perturbation_id", "split", "application_decision", "regression_magnitude_pct", "severe", "application_evidence_sha256", "environment_sha256", "candidate_subject_sha256", "application_metrics"],
        "properties": {
          "perturbation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "split": {"enum": ["training", "holdout"]},
          "application_decision": {"enum": ["pass", "fail"]},
          "regression_magnitude_pct": {"type": "number", "minimum": 0},
          "severe": {"type": "boolean"},
          "application_evidence_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
          "environment_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
          "candidate_subject_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
          "application_metrics": {"$ref": "#/$defs/physicalMetrics"}
        },
        "additionalProperties": false
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "method", "selected_region_ids", "executable_sha256", "observations"],
        "properties": {
          "candidate_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
          "method": {"enum": ["reduced_decision_canary", "independent_exact_replay", "random_sampling", "stratified_sampling", "ddmin", "communication_only_microbenchmark"]},
          "selected_region_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"}},
          "executable_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["perturbation_id", "decision", "evidence_sha256", "physical_metrics"],
              "properties": {
                "perturbation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
                "decision": {"enum": ["pass", "fail"]},
                "evidence_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
                "physical_metrics": {"$ref": "#/$defs/physicalMetrics"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "physicalMetrics": {
      "type": "object",
      "required": ["physical_runtime_seconds", "gpu_seconds", "gpu_count", "executed_collectives", "executed_flops", "peak_memory_bytes"],
      "properties": {
        "physical_runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
        "gpu_seconds": {"type": "number", "exclusiveMinimum": 0},
        "gpu_count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "executed_collectives": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "executed_flops": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "peak_memory_bytes": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
