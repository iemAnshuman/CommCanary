{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.physical_gate_observation.v1.schema.json",
  "title": "CommCanary physical gate observation v1",
  "type": "object",
  "required": ["format", "bundle_id", "role", "subject_sha256", "environment_sha256", "runner_oci_digest", "executable_sha256", "evidence_sha256", "samples"],
  "properties": {
    "format": {"const": "commcanary.physical_gate_observation.v1"},
    "bundle_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "role": {"enum": ["baseline", "candidate"]},
    "subject_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "environment_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "runner_oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executable_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "evidence_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "samples": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number", "minimum": 0}
      }
    }
  },
  "additionalProperties": false
}
