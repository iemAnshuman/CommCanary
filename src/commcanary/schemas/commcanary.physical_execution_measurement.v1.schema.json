{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.physical_execution_measurement.v1.schema.json",
  "title": "CommCanary physical execution measurement v1",
  "type": "object",
  "required": ["format", "measurement_id", "role", "runner", "subject_sha256", "perturbation_id", "source_et_sha256", "executable_sha256", "projection_id", "selected_region_ids", "selected_node_ids", "execution", "correctness", "samples", "physical_metrics", "environment", "environment_sha256", "telemetry", "telemetry_assessment"],
  "properties": {
    "format": {"const": "commcanary.physical_execution_measurement.v1"},
    "measurement_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "role": {"enum": ["trace_derived_reference", "reduced_decision_canary"]},
    "runner": {
      "type": "object",
      "required": ["oci_digest", "execution_protocol"],
      "properties": {
        "oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "execution_protocol": {"const": "chakra-et-collective-graph.v1"}
      },
      "additionalProperties": false
    },
    "subject_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "perturbation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
    "source_et_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "executable_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "projection_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "selected_region_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"}
    },
    "selected_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "execution": {
      "type": "object",
      "required": ["world_size", "warmups", "iterations", "disable_overlap", "communication_only", "rank_skew_us", "rank_skew_mechanism", "collective_buffer_slots", "workspace_bytes_max_rank"],
      "properties": {
        "world_size": {"type": "integer", "minimum": 2, "maximum": 65536},
        "warmups": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "iterations": {"type": "integer", "minimum": 2},
        "disable_overlap": {"type": "boolean"},
        "communication_only": {"type": "boolean"},
        "rank_skew_us": {"type": "number", "minimum": 0},
        "rank_skew_mechanism": {"const": "host_issue_monotonic_spin"},
        "collective_buffer_slots": {"type": "integer", "minimum": 1, "maximum": 1024},
        "workspace_bytes_max_rank": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["rank", "passed", "validated_node_ids", "commitment_sha256"],
        "properties": {
          "rank": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
          "passed": {"const": true},
          "validated_node_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "commitment_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["iteration", "cuda_seconds_by_rank", "host_seconds_by_rank", "physical_runtime_seconds", "peak_memory_bytes_by_rank"],
        "properties": {
          "iteration": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
          "cuda_seconds_by_rank": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
          "host_seconds_by_rank": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
          "physical_runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
          "peak_memory_bytes_by_rank": {"type": "array", "minItems": 2, "items": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}}
        },
        "additionalProperties": false
      }
    },
    "physical_metrics": {"$ref": "#/$defs/physicalMetrics"},
    "environment": {"$ref": "#/$defs/environment"},
    "environment_sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "telemetry": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/telemetrySnapshot"}
    },
    "telemetry_assessment": {"$ref": "#/$defs/telemetryAssessment"}
  },
  "$defs": {
    "physicalMetrics": {
      "type": "object",
      "required": ["physical_runtime_seconds", "gpu_seconds", "gpu_count", "executed_collectives", "executed_flops", "peak_memory_bytes"],
      "properties": {
        "physical_runtime_seconds": {"type": "number", "exclusiveMinimum": 0},
        "gpu_seconds": {"type": "number", "exclusiveMinimum": 0},
        "gpu_count": {"type": "integer", "minimum": 2, "maximum": 65536},
        "executed_collectives": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "executed_flops": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "peak_memory_bytes": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["hostname", "platform", "python", "torch", "cuda", "nccl", "world_size", "slurm_job_id", "slurm_node", "nccl_configuration"],
      "properties": {
        "hostname": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "platform": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "python": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "torch": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "cuda": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "nccl": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}},
        "world_size": {"type": "integer", "minimum": 2, "maximum": 65536},
        "slurm_job_id": {"type": ["string", "null"]},
        "slurm_node": {"type": ["string", "null"]},
        "nccl_configuration": {
          "type": "object",
          "required": ["NCCL_ALGO", "NCCL_PROTO", "NCCL_NET", "NCCL_P2P_DISABLE", "NCCL_SHM_DISABLE"],
          "properties": {
            "NCCL_ALGO": {"type": ["string", "null"]},
            "NCCL_PROTO": {"type": ["string", "null"]},
            "NCCL_NET": {"type": ["string", "null"]},
            "NCCL_P2P_DISABLE": {"type": ["string", "null"]},
            "NCCL_SHM_DISABLE": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "gpu": {
      "type": "object",
      "required": ["index", "uuid", "pstate", "sm_clock_mhz", "memory_clock_mhz", "temperature_c", "power_w", "clock_event_reasons_active", "corrected_volatile_ecc", "uncorrected_volatile_ecc"],
      "properties": {
        "index": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "uuid": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "pstate": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "sm_clock_mhz": {"type": "number", "minimum": 0},
        "memory_clock_mhz": {"type": "number", "minimum": 0},
        "temperature_c": {"type": "number"},
        "power_w": {"type": "number", "minimum": 0},
        "clock_event_reasons_active": {"type": "string"},
        "corrected_volatile_ecc": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "uncorrected_volatile_ecc": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"}
      },
      "additionalProperties": false
    },
    "telemetrySnapshot": {
      "type": "object",
      "required": ["phase", "monotonic_ns", "gpu_observation", "xid_observation", "slurm_node_observation"],
      "properties": {
        "phase": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonEmptyString"},
        "monotonic_ns": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "gpu_observation": {
          "type": "object",
          "required": ["status", "command", "returncode", "gpus", "stderr"],
          "properties": {
            "status": {"enum": ["complete", "unavailable"]},
            "command": {"$ref": "#/$defs/command"},
            "returncode": {"type": ["integer", "null"]},
            "gpus": {"type": "array", "items": {"$ref": "#/$defs/gpu"}},
            "stderr": {"type": "string"}
          },
          "additionalProperties": false
        },
        "xid_observation": {
          "type": "object",
          "required": ["status", "command", "lines", "sha256", "stderr"],
          "properties": {
            "status": {"enum": ["complete", "unavailable"]},
            "command": {"$ref": "#/$defs/command"},
            "lines": {"type": "array", "items": {"type": "string"}},
            "sha256": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
            "stderr": {"type": "string"}
          },
          "additionalProperties": false
        },
        "slurm_node_observation": {
          "type": "object",
          "required": ["status", "command", "node", "state", "stderr"],
          "properties": {
            "status": {"enum": ["complete", "unavailable"]},
            "command": {"$ref": "#/$defs/command"},
            "node": {"type": ["string", "null"]},
            "state": {"type": ["string", "null"]},
            "stderr": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "optionalNumber": {"type": ["number", "null"]},
    "telemetryAssessment": {
      "type": "object",
      "required": ["comparable", "issues", "gpu_snapshot_count", "stable_gpu_uuid_order", "gpu_uuid_order", "xid_observation_available", "xid_observation_changed", "slurm_node_observation_available", "corrected_volatile_ecc_delta", "uncorrected_volatile_ecc_delta", "observed_pstates", "sm_clock_mhz_min", "sm_clock_mhz_max", "memory_clock_mhz_min", "memory_clock_mhz_max", "temperature_c_min", "temperature_c_max", "power_w_min", "power_w_max"],
      "properties": {
        "comparable": {"type": "boolean"},
        "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "gpu_snapshot_count": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/nonNegativeInteger"},
        "stable_gpu_uuid_order": {"type": "boolean"},
        "gpu_uuid_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "xid_observation_available": {"type": "boolean"},
        "xid_observation_changed": {"type": "boolean"},
        "slurm_node_observation_available": {"type": "boolean"},
        "corrected_volatile_ecc_delta": {"type": "array", "items": {"type": "integer"}},
        "uncorrected_volatile_ecc_delta": {"type": "array", "items": {"type": "integer"}},
        "observed_pstates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sm_clock_mhz_min": {"$ref": "#/$defs/optionalNumber"},
        "sm_clock_mhz_max": {"$ref": "#/$defs/optionalNumber"},
        "memory_clock_mhz_min": {"$ref": "#/$defs/optionalNumber"},
        "memory_clock_mhz_max": {"$ref": "#/$defs/optionalNumber"},
        "temperature_c_min": {"$ref": "#/$defs/optionalNumber"},
        "temperature_c_max": {"$ref": "#/$defs/optionalNumber"},
        "power_w_min": {"$ref": "#/$defs/optionalNumber"},
        "power_w_max": {"$ref": "#/$defs/optionalNumber"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
