{
  "$id": "commcanary.rostam.cross-commit-compatibility.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "repository": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "patch_sha256": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_archive_sha256": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "commit",
        "dirty",
        "patch_sha256",
        "source_archive_sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_differences": {
      "additionalProperties": false,
      "properties": {
        "analysis_policy_fields": {
          "items": {
            "const": "script_hashes"
          },
          "maxItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "input_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
            "type": "string"
          },
          "maxItems": 1000,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "analysis_policy_fields",
        "input_ids"
      ],
      "type": "object"
    },
    "analysis_implementation": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size_bytes": {
                "maximum": 9223372036854775807,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "type": "object"
          },
          "maxItems": 10000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "fingerprint",
        "files"
      ],
      "type": "object"
    },
    "campaigns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "campaign_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "selection_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "verdict_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "manifest_sha256",
          "run_id",
          "campaign_id",
          "selection_sha256",
          "verdict_sha256",
          "repository"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ground_truth": {
      "additionalProperties": false,
      "properties": {
        "absolute_threshold_us": {
          "minimum": 0,
          "type": "number"
        },
        "baseline_config": {
          "oneOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_config": {
          "oneOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256s": {
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "maxItems": 9999,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "publication_sha256": {
          "additionalProperties": false,
          "properties": {
            "aggregate.csv": {
              "$ref": "#/$defs/sha256"
            },
            "aggregate.json": {
              "$ref": "#/$defs/sha256"
            },
            "paper-fragment.md": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "aggregate.json",
            "aggregate.csv",
            "paper-fragment.md"
          ],
          "type": "object"
        },
        "raw_archive_verified": {
          "type": "boolean"
        },
        "regeneration_command": {
          "maxLength": 8192,
          "minLength": 1,
          "type": "string"
        },
        "relative_threshold_pct": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "manifest_sha256s",
        "regeneration_command",
        "baseline_config",
        "candidate_config",
        "relative_threshold_pct",
        "absolute_threshold_us",
        "publication_sha256",
        "raw_archive_verified"
      ],
      "type": "object"
    },
    "schema": {
      "const": "commcanary.rostam.cross-commit-compatibility.v1"
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed"
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "analysis_implementation",
    "campaigns",
    "ground_truth",
    "allowed_differences",
    "contract_sha256"
  ],
  "type": "object"
}
