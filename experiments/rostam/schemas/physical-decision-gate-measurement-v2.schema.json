{
  "$id": "commcanary.rostam.physical.decision-gate-measurement.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {"pattern": "^a-[0-9]{6}$", "type": "string"},
    "correctness_check_count": {"maximum": 1000000, "minimum": 1, "type": "integer"},
    "correctness": {
      "additionalProperties": false,
      "properties": {
        "status": {"const": "passed"},
        "semantics": {"const": "complete-source-and-exact-work-output-commitment-comparison"},
        "checks_per_rank": {"items": {"minimum": 1, "type": "integer"}, "minItems": 1, "type": "array"},
        "total_check_count": {"minimum": 1, "type": "integer"},
        "source_output_commitment_sha256_by_rank": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "minItems": 1, "type": "array"},
        "exact_work_output_commitment_sha256_by_rank": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "minItems": 1, "type": "array"},
        "backend_smoke_check": {
          "additionalProperties": false,
          "properties": {
            "status": {"const": "passed"},
            "semantics": {"const": "one-blocking-sum-check-per-collective-shape"},
            "checks_per_rank": {"items": {"minimum": 1, "type": "integer"}, "minItems": 1, "type": "array"},
            "total_check_count": {"minimum": 1, "type": "integer"}
          },
          "required": ["checks_per_rank", "semantics", "status", "total_check_count"],
          "type": "object"
        }
      },
      "required": ["backend_smoke_check", "checks_per_rank", "exact_work_output_commitment_sha256_by_rank", "semantics", "source_output_commitment_sha256_by_rank", "status", "total_check_count"],
      "type": "object"
    },
    "count": {"maximum": 1000, "minimum": 1, "type": "integer"},
    "decision_claims": {
      "additionalProperties": false,
      "properties": {
        "physical_decision_fidelity": {"const": "not_analyzed"},
        "physical_execution": {"const": "same_allocation_self_reported"},
        "qualification_verdict": {"const": "policy_bound_not_issued"}
      },
      "required": ["physical_decision_fidelity", "physical_execution", "qualification_verdict"],
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "configuration_repetition": {"maximum": 999, "minimum": 0, "type": "integer"},
        "iterations": {"const": 24},
        "order_method": {"const": "configuration-repetition-frozen-global-carryover-design.v4"},
        "representation_order_by_iteration": {
          "items": {
            "items": {
              "enum": ["source", "exact_work", "stratified", "isolated", "no_overlap", "no_rank_skew"]
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array",
            "uniqueItems": true
          },
          "maxItems": 24,
          "minItems": 24,
          "type": "array"
        },
        "representation_order_by_warmup": {
          "items": {
            "items": {
              "enum": ["source", "exact_work", "stratified", "isolated", "no_overlap", "no_rank_skew"]
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array",
            "uniqueItems": true
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "representation_schedule_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "source_event_count": {"minimum": 1, "type": "integer"},
        "stratified_method": {"const": "first-observed-per-collective-shape.v1"},
        "stratified_source_event_indices": {
          "items": {"minimum": 0, "type": "integer"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "timing_semantics": {"const": "maximum-rank-cuda-event-whole-program-duration"},
        "warmup": {"const": 6},
        "world_size": {"maximum": 1024, "minimum": 1, "type": "integer"}
      },
      "required": ["configuration_repetition", "iterations", "order_method", "representation_order_by_iteration", "representation_order_by_warmup", "representation_schedule_sha256", "source_event_count", "stratified_method", "stratified_source_event_indices", "timing_semantics", "warmup", "world_size"],
      "type": "object"
    },
    "global_ranks": {
      "items": {"minimum": 0, "type": "integer"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "iqr_us": {"minimum": 0, "type": "number"},
    "materialization": {
      "additionalProperties": false,
      "properties": {
        "materialization_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "program_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["materialization_id", "program_sha256"],
      "type": "object"
    },
    "operation": {"const": "all_reduce"},
    "policy": {
      "additionalProperties": false,
      "properties": {
        "format": {"const": "commcanary.qualification_policy.v1"},
        "policy_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["format", "policy_id"],
      "type": "object"
    },
    "representations": {
      "additionalProperties": false,
      "properties": {
        "exact_work": {"$ref": "#/$defs/representation"},
        "isolated": {"$ref": "#/$defs/representation"},
        "no_overlap": {"$ref": "#/$defs/representation"},
        "no_rank_skew": {"$ref": "#/$defs/representation"},
        "source": {"$ref": "#/$defs/representation"},
        "stratified": {"$ref": "#/$defs/representation"}
      },
      "required": ["exact_work", "isolated", "no_overlap", "no_rank_skew", "source", "stratified"],
      "type": "object"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "format": {"const": "commcanary.qualification_request.v2"},
        "request_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["format", "request_id"],
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "hostname": {"minLength": 1, "type": "string"},
        "job_id": {"type": ["string", "null"]},
        "python_version": {"minLength": 1, "type": "string"},
        "runtime_nccl_version_code": {"maximum": 99999, "minimum": 1, "type": "integer"},
        "torch_cuda_version": {"type": ["string", "null"]},
        "torch_version": {"minLength": 1, "type": "string"}
      },
      "required": ["hostname", "job_id", "python_version", "runtime_nccl_version_code", "torch_cuda_version", "torch_version"],
      "type": "object"
    },
    "samples_us": {
      "items": {"minimum": 0, "type": "number"},
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "telemetry_checkpoints": {
      "additionalProperties": false,
      "properties": {
        "method": {"const": "bounded-between-six-row-cycles.v1"},
        "schema": {"const": "commcanary.rostam.decision-gate-cycle-telemetry.v1"},
        "snapshots": {
          "items": {"$ref": "#/$defs/telemetry_snapshot"},
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        }
      },
      "required": ["method", "schema", "snapshots"],
      "type": "object"
    },
    "value_us": {"minimum": 0, "type": "number"},
    "wall_time_s": {"minimum": 0, "type": "number"},
    "world_size": {"maximum": 1024, "minimum": 1, "type": "integer"}
  },
  "required": ["attempt_id", "correctness", "correctness_check_count", "count", "decision_claims", "execution", "global_ranks", "iqr_us", "materialization", "operation", "policy", "representations", "request", "runtime", "samples_us", "telemetry_checkpoints", "value_us", "wall_time_s", "world_size"],
  "type": "object",
  "$defs": {
    "cycle_gpu": {
      "additionalProperties": false,
      "properties": {
        "ecc_corrected_volatile_total": {"minimum": 0, "type": "integer"},
        "ecc_uncorrected_volatile_total": {"minimum": 0, "type": "integer"},
        "index": {"minimum": 0, "type": "integer"},
        "memory_clock_mhz": {"minimum": 0, "type": "integer"},
        "performance_state": {"minLength": 1, "type": "string"},
        "power_draw_w": {"minimum": 0, "type": "number"},
        "sm_clock_mhz": {"minimum": 0, "type": "integer"},
        "temperature_c": {"maximum": 200, "minimum": -50, "type": "integer"},
        "throttle_reasons_active": {"pattern": "^0x[0-9a-f]{16}$", "type": "string"},
        "uuid": {"minLength": 1, "type": "string"}
      },
      "required": ["ecc_corrected_volatile_total", "ecc_uncorrected_volatile_total", "index", "memory_clock_mhz", "performance_state", "power_draw_w", "sm_clock_mhz", "temperature_c", "throttle_reasons_active", "uuid"],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "count": {"const": 24},
        "iqr_us": {"minimum": 0, "type": "number"},
        "max_us": {"minimum": 0, "type": "number"},
        "median_us": {"minimum": 0, "type": "number"},
        "min_us": {"minimum": 0, "type": "number"}
      },
      "required": ["count", "iqr_us", "max_us", "median_us", "min_us"],
      "type": "object"
    },
    "representation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": ["causal_ablation", "exact_materialization_control", "incumbent_baseline", "kill_condition_baseline", "trace_derived_reference"]
        },
        "executed_event_count": {"minimum": 1, "type": "integer"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "rank_timings_us": {
          "items": {
            "items": {"minimum": 0, "type": "number"},
            "maxItems": 24,
            "minItems": 24,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "semantics": {"minLength": 1, "type": "string"},
        "template_count": {"minimum": 1, "type": "integer"},
        "timings_us": {
          "items": {"minimum": 0, "type": "number"},
          "maxItems": 24,
          "minItems": 24,
          "type": "array"
        }
      },
      "required": ["category", "executed_event_count", "metrics", "rank_timings_us", "semantics", "template_count", "timings_us"],
      "type": "object"
    },
    "telemetry_snapshot": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {"format": "date-time", "type": "string"},
        "gpus": {
          "items": {"$ref": "#/$defs/cycle_gpu"},
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "label": {
          "enum": ["before_warmup", "before_measured_cycle_1", "after_measured_cycle_1", "after_measured_cycle_2", "after_measured_cycle_3", "after_measured_cycle_4", "final"]
        },
        "node_state": {
          "additionalProperties": false,
          "properties": {
            "method": {"const": "scontrol show node --oneliner HOSTNAME"},
            "node": {"minLength": 1, "type": "string"},
            "state": {"minLength": 1, "type": "string"}
          },
          "required": ["method", "node", "state"],
          "type": "object"
        },
        "xid": {
          "additionalProperties": false,
          "properties": {
            "event_count": {"minimum": 0, "type": "integer"},
            "method": {"const": "journalctl --dmesg --boot --no-pager --grep NVRM.*Xid"},
            "window_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
          },
          "required": ["event_count", "method", "window_sha256"],
          "type": "object"
        }
      },
      "required": ["captured_at", "gpus", "label", "node_state", "xid"],
      "type": "object"
    }
  }
}
