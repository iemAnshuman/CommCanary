{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commcanary.dev/schemas/commcanary.qualification_verdict.v1.schema.json",
  "title": "CommCanary qualification verdict v1",
  "type": "object",
  "required": ["format", "verdict_id", "policy_id", "baseline_observation_id", "candidate_observation_id", "verdict", "reason_codes", "explanation", "statistics", "claims"],
  "properties": {
    "format": {"const": "commcanary.qualification_verdict.v1"},
    "verdict_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "policy_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "baseline_observation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "candidate_observation_id": {"$ref": "https://commcanary.dev/schemas/common.schema.json#/$defs/sha256"},
    "verdict": {"enum": ["pass", "fail", "inconclusive", "incomparable"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "explanation": {"type": "string", "minLength": 1},
    "statistics": {
      "type": "object",
      "required": ["baseline_sample_count", "candidate_sample_count", "baseline_median_us", "candidate_median_us", "signed_difference_us", "signed_difference_pct", "acceptance_threshold_us", "confidence", "confidence_interval_lower_us", "confidence_interval_upper_us", "bootstrap_resamples", "baseline_relative_iqr_pct", "candidate_relative_iqr_pct"],
      "properties": {
        "baseline_sample_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "candidate_sample_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "baseline_median_us": {"type": ["number", "null"]},
        "candidate_median_us": {"type": ["number", "null"]},
        "signed_difference_us": {"type": ["number", "null"]},
        "signed_difference_pct": {"type": ["number", "null"]},
        "acceptance_threshold_us": {"type": ["number", "null"]},
        "confidence": {"type": ["number", "null"]},
        "confidence_interval_lower_us": {"type": ["number", "null"]},
        "confidence_interval_upper_us": {"type": ["number", "null"]},
        "bootstrap_resamples": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "baseline_relative_iqr_pct": {"type": ["number", "null"]},
        "candidate_relative_iqr_pct": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["policy_application", "physical_decision", "producer_authenticity"],
      "properties": {
        "policy_application": {"const": "recomputed"},
        "physical_decision": {"enum": ["pass", "fail", "inconclusive", "incomparable"]},
        "producer_authenticity": {"const": "unsigned"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
